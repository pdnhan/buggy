# dependencies
/node_modules
mcp-server/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# build
/dist
/build
mcp-server/dist/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.gstack/

# CodeGraph local index (sqlite db, WAL, daemon pid/log) — machine-local, ~10M
.codegraph/

# Assistant tooling configs that are personal rather than project-wide.
# .claude/ and .mcp.json are intentionally NOT ignored: they configure the
# MCP server this repo ships in mcp-server/, so they are shared setup.
.gemini/
GEMINI.md
opencode.jsonc
